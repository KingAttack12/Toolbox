[Unit]
Description=Toolbox local AI trial (Qwen3)
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=toolbox-ai
WorkingDirectory=/var/lib/toolbox-ai
ExecStart=/opt/toolbox-ai/bin/ollama serve
Environment=HOME=/var/lib/toolbox-ai
Environment=OLLAMA_MODELS=/var/lib/toolbox-ai/models
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=1
Environment=OLLAMA_CONTEXT_LENGTH=2048
Environment=OLLAMA_KEEP_ALIVE=2m
CPUQuota=150%
MemoryMax=4G
MemorySwapMax=0
TasksMax=64
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

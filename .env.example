# --- Auth (change impérativement le mot de passe via generate_password.py) ---
TOOLBOX_USERNAME=admin
# Format: pbkdf2_sha256$iterations$salt_hex$hash_hex
# Valeur initiale = mot de passe "change-moi" (à régénérer !)
TOOLBOX_PASSWORD_HASH=
TOOLBOX_SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire-32-caracteres-min

# --- Fichiers ---
TOOLBOX_DATA_DIR=./data/tmp
TOOLBOX_TMP_TTL_HOURS=2
TOOLBOX_MAX_TEXT_CHARS=500000
TOOLBOX_MAX_UPLOAD_MB=50

# --- Serveur ---
TOOLBOX_HOST=127.0.0.1
TOOLBOX_PORT=8000

